        "publisher": "Looki",
        "published_at": null,
        "observed_at": "2026-10-24",
        "access": "partial",
        "limitations": [
          "价格与服务方案为当日页面陈述；未下单、核验售后适用条件或审计评价真实性。"
        ],
        "capture": "美元页面显示硬件249美元、32克；搭配App把间隔采集内容整理为vlog、漫画与回顾。FAQ说明主要采用间隔记录，并非全天连续录像；标准服务目前无强制订阅，未来可能有可选高级层。购买区附近展示30天退货、一年保修；评价模块提示部分评价来自商家合并的相关商品。",
        "claims": [
          {
            "text": "页面显示249美元、标准服务目前无强制订阅，未来可能增加可选高级层。",
            "kind": "official_claim",
            "locator": "Price；FAQ / Are there any subscriptions or hidden costs?"
          },
          {
            "text": "购买区旁展示退货与保修；FAQ解释间隔采集和连续拍摄的区别。",
            "kind": "observed_feature",
            "locator": "Add to cart下方；FAQ / Can Looki L1 record video continuously all day?"
          }
        ],
        "url": "https://www.looki.ai/products/looki-l1"
      },
      "capture_sha256": "f31faf623c71d0b209ee8c5d3a7597b4ab3bf204b001858e36e4d0950c8b77d3"
    },
